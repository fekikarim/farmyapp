# Production Flutter Environment Variables
# IMPORTANT: For App Store release, API_BASE_URL must be your production HTTPS URL
# Example: https://your-backend.onrender.com or https://api.farmyapp.com

# PRODUCTION API URL (Required for App Store)
API_BASE_URL=https://your-production-api-url.com

# Development/Testing (only for local builds)
# API_BASE_URL=http://localhost:3001

# OAuth Client IDs (from your OAuth providers)
GITHUB_CLIENT_ID=your_github_client_id

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Required if Apple Pay is enabled
STRIPE_MERCHANT_IDENTIFIER=merchant.com.yourcompany.farmy

# Apple Sign-In is automatically handled by iOS - no additional config needed here
